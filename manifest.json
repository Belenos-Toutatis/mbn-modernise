{
  "manifest_version": 3,
  "name": "MBN modernisé",
  "version": "0.34.2",
  "description": "Corrige et modernise l'affichage de Mon Bureau Numérique (messagerie, aperçus PDF).",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.monbureaunumerique.fr/*"
  ],
  "action": {
    "default_title": "MBN modernisé",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.monbureaunumerique.fr/*"
      ],
      "css": [
        "commun.css",
        "messagerie.css",
        "messagerie-moderne.css",
        "apercu-pdf.css",
        "agenda-moderne.css",
        "cahier-liste.css",
        "devoirs.css",
        "appels.css",
        "seance.css",
        "copier-vers.css",
        "ressources.css",
        "reservations.css",
        "roue-heure.css",
        "calendriers.css",
        "menu.css"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "moderne.js"
      ]
    },
    {
      "matches": [
        "*://*.monbureaunumerique.fr/*"
      ],
      "js": [
        "couleurs-classes.js",
        "periodes.js",
        "content.js",
        "messagerie.js",
        "apercu-pdf.js",
        "agenda.js",
        "seance.js",
        "copier-vers.js",
        "ressources.js",
        "reservations.js",
        "planning-resa.js",
        "roue-heure.js",
        "heures-anciennes.js",
        "saisie-resa.js",
        "cahier-liste.js",
        "cahier-criteres.js",
        "cahier-choix.js",
        "devoirs.js",
        "appels.js",
        "menu.js",
        "rafraichissement.js",
        "infobulles.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.monbureaunumerique.fr/*"
      ],
      "js": [
        "pont.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "arriere-plan.js"
  }
}
